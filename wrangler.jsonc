{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "garantia-worker",
	"main": "src/index.js",
	"compatibility_date": "2026-05-25",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "garantia-index-gemini"
		}
	],
	"kv_namespaces": [
		{
			"binding": "garantia_cache",
			"id": "d1f39512c3204c818120f62cff06e8d4"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "GEMINI_LIMITER",
				"class_name": "GeminiRateLimiter"
			},
			{
				"name": "INGEST_JOB",
				"class_name": "IngestJob"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["GeminiRateLimiter"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["IngestJob"]
		}
	]
}
